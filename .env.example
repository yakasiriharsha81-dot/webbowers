# Polar Science Hub Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=polar-science-hub-insecure-dev-secret-change-in-production-2026
DATABASE_URL=sqlite:///polar_science.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=33554432  # 32 MB

# Security Settings
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URI=memory://
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# AI Service Settings
LLM_PROVIDER=mock  # Options: mock, openai, anthropic, gemini
LLM_API_KEY=
LLM_MODEL=
